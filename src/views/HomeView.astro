---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Process from '../components/Process.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
import { testimonials } from '../data/testimonials';
import { routes, useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const featured = projects.slice(0, 4);
const facts = [1, 2, 3, 4].map((n) => ({
  value: t(`facts.${n}.value` as 'facts.1.value'),
  label: t(`facts.${n}.label` as 'facts.1.label'),
}));
const seo = {
  fr: {
    title: 'Kaenys · Agence digitale à Douala : design, vidéo, web et IA',
    description: 'Agence digitale à Douala, Cameroun : design et identité visuelle, community management, montage vidéo, sites web, solutions d’IA et formation. Devis sous 48 h.',
  },
  en: {
    title: 'Kaenys · Digital agency in Douala: design, video, web and AI',
    description: 'Digital agency in Douala, Cameroon: brand identity, social media management, video editing, websites, AI solutions and training. Quote within 48 hours.',
  },
}[lang];
---
<Layout lang={lang} title={seo.title} description={seo.description} altHref={routes.home[lang === 'fr' ? 'en' : 'fr']} current="home">
  <Hero lang={lang} />

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t('home.services.eyebrow')}</p>
        <h2 id="services-title" class="t-1">{t('home.services.title')}</h2>
        <p class="lead">{t('home.services.lead')}</p>
      </div>
      <ServiceTiles lang={lang} />
    </div>
  </section>

  <section class="section bg-soft" aria-labelledby="work-title">
    <div class="container">
      <div class="work-head" data-reveal>
        <div>
          <p class="eyebrow">{t('home.work.eyebrow')}</p>
          <h2 id="work-title" class="t-1">{t('home.work.title')}</h2>
        </div>
        <a class="link-arrow" href={routes.work[lang]}>{t('home.work.all')} <Icon name="chevron" /></a>
      </div>
      <div class="work-grid">
        {featured.map((p, i) => <ProjectCard project={p} lang={lang} delay={(i % 2) * 100} large={i === 0} />)}
      </div>
    </div>
  </section>

  <Process lang={lang} />

  <section class="section" aria-labelledby="facts-title">
    <div class="container">
      <h2 id="facts-title" class="t-2 facts-title" data-reveal>{t('home.facts.title')}</h2>
      <dl class="facts">
        {facts.map((f, i) => (
          <div class="fact" data-reveal style={`--delay:${i * 90}ms`}>
            <dt class="fact-value display">{f.value}</dt>
            <dd class="fact-label">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section bg-soft" aria-labelledby="testi-title">
      <div class="container">
        <h2 id="testi-title" class="t-2" data-reveal>{t('home.testimonials.title')}</h2>
        <div class="testis">
          {testimonials.map((q, i) => (
            <figure class="testi card" data-reveal style={`--delay:${i * 90}ms`}>
              <blockquote class="t-4">« {q.quote[lang]} »</blockquote>
              <figcaption><strong>{q.name}</strong><span class="muted">{q.role[lang]}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA lang={lang} />
</Layout>

<style>
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .work-head h2 { max-width: 14ch; }
  .work-grid { display: grid; gap: 48px 24px; }
  @media (min-width: 720px) {
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-grid > :global(.large) { grid-column: 1 / -1; }
  }

  .facts-title { max-width: 16ch; margin-bottom: clamp(40px, 6vw, 72px); }
  .facts { display: grid; gap: 0; margin: 0; border-top: 1px solid var(--line); }
  .fact { padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .fact-value { font-size: clamp(3rem, 7vw, 5rem); line-height: 1; letter-spacing: -0.04em; }
  .fact-label { margin: 0.75rem 0 0; color: var(--muted); max-width: 24ch; }
  @media (min-width: 720px) {
    .facts { grid-template-columns: repeat(2, 1fr); border-top: 0; }
    .fact { border-bottom: 0; border-top: 1px solid var(--line); padding-right: 2rem; }
  }
  @media (min-width: 1100px) { .facts { grid-template-columns: repeat(4, 1fr); } }

  .testis { display: grid; gap: 20px; margin-top: 48px; }
  @media (min-width: 900px) { .testis { grid-template-columns: repeat(3, 1fr); } }
  .testi { margin: 0; background: var(--white); display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .testi blockquote { margin: 0; font-family: var(--font-display); color: var(--night); font-weight: 500; }
  .testi figcaption { display: grid; gap: 0.15rem; font-size: 0.9375rem; }
</style>
