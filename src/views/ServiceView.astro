---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { servicePath, type Service } from '../data/services';
import { projects } from '../data/projects';
import { plans, formatFCFA } from '../data/pricing';
import { routes, useT, otherLang, type Lang } from '../i18n/ui';
import { SITE } from '../config';

interface Props { lang: Lang; service: Service }
const { lang, service: s } = Astro.props;
const t = useT(lang);
const quoteHref = `${routes.contact[lang]}?service=${s.id}`;
const related = projects.filter((p) => p.service === s.id).slice(0, 2);
const plan = plans.find((p) => p.service === s.id);
const waMessage = `${t('wa.serviceMessage')}${s.title[lang]}`;
const place = lang === 'fr' ? 'Douala, Cameroun' : 'Douala, Cameroon';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title[lang],
    description: s.intro[lang],
    provider: { '@id': `${SITE.url}/#org` },
    areaServed: 'CM',
    url: new URL(servicePath(s, lang), SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq[lang].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Layout
  lang={lang}
  title={`${s.title[lang]} ${lang === 'fr' ? 'à' : 'in'} Douala`}
  description={`${s.short[lang]} ${place}.`}
  altHref={servicePath(s, otherLang(lang))}
  current="services"
  waMessage={waMessage}
  jsonLd={jsonLd}
>
  <header class="svc-hero container">
    <a class="svc-back small" href={routes.services[lang]}><Icon name="chevron" size={14} class="flip" /> {t('nav.services')}</a>
    <div class="svc-hero-grid">
      <div>
        <p class="eyebrow in">{s.title[lang]}</p>
        <h1 class="t-1 in" style="--d:.08s">{s.headline[lang]}</h1>
        <p class="lead in" style="--d:.16s">{s.intro[lang]}</p>
        <div class="actions in" style="--d:.24s">
          <a class="btn btn-primary btn-lg" href={quoteHref}>{t('service.cta')}</a>
          {plan && (
            <span class="svc-price">
              {plan.from ? <>{t('service.from')} <strong>{formatFCFA(plan.from, lang)}</strong></> : t('pricing.onQuote')}
            </span>
          )}
        </div>
      </div>
      <div class="svc-visual in" style="--d:.2s" aria-hidden="true">
        <svg class="svc-chev c1" viewBox="0 0 234 118"><path d="M115 0 234 117H167L115 65 64 117H0Z" /></svg>
        <svg class="svc-chev c2" viewBox="0 0 234 118"><path d="M115 0 234 117H167L115 65 64 117H0Z" /></svg>
        <span class="svc-visual-icon"><Icon name={s.icon} size={72} /></span>
      </div>
    </div>
  </header>

  <section class="section-tight" aria-label={t('service.included')}>
    <div class="container">
      <div class="bento">
        <div class="cell cell-a bg-night" data-reveal>
          <h2 class="t-3">{t('service.included')}</h2>
          <ul class="list-k">{s.included[lang].map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="cell cell-b" data-reveal style="--delay:80ms">
          <h2 class="t-4">{t('service.forWho')}</h2>
          <ul class="list-k">{s.forWho[lang].map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="cell cell-c" data-reveal style="--delay:160ms">
          <Icon name="clock" size={28} />
          <h2 class="small muted">{t('service.delay')}</h2>
          <p class="t-3 display">{s.delay[lang]}</p>
        </div>
        <div class="cell cell-d" data-reveal style="--delay:120ms">
          <h2 class="t-4">{t('service.deliverables')}</h2>
          <ul class="chips">{s.deliverables[lang].map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-tight" aria-labelledby="rel-title">
      <div class="container">
        <h2 id="rel-title" class="t-2 block-title" data-reveal>{t('service.work')}</h2>
        <div class="rel-grid">
          {related.map((p, i) => <ProjectCard project={p} lang={lang} delay={i * 100} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section-tight" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <h2 id="faq-title" class="t-2" data-reveal>{t('service.faq')}</h2>
      <div data-reveal style="--delay:80ms"><FAQ items={s.faq[lang]} /></div>
    </div>
  </section>

  <section class="section bg-soft" aria-labelledby="others-title">
    <div class="container">
      <h2 id="others-title" class="t-2 block-title" data-reveal>{t('service.others')}</h2>
      <ServiceTiles lang={lang} exclude={s.id} />
    </div>
  </section>

  <CTA lang={lang} href={quoteHref} waMessage={waMessage} />
</Layout>

<style>
  .svc-hero { padding-top: clamp(28px, 4vw, 48px); padding-bottom: clamp(48px, 7vw, 96px); }
  .svc-back {
    display: inline-flex; align-items: center; gap: 0.35rem;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: clamp(24px, 5vw, 64px);
  }
  .svc-back:hover { color: var(--night); }
  .svc-back :global(.flip) { transform: rotate(180deg); }
  .svc-hero-grid { display: grid; gap: 3rem; align-items: center; }
  .svc-hero h1 { max-width: 16ch; }
  .svc-hero .lead { margin-top: 1.5rem; max-width: 42ch; }
  .svc-hero .actions { margin-top: 2.25rem; }
  .svc-price { color: var(--muted); }
  .svc-price strong { color: var(--night); font-weight: 600; }

  .svc-visual {
    position: relative;
    aspect-ratio: 1;
    max-width: 440px;
    width: 100%;
    justify-self: center;
    border-radius: var(--radius);
    background: var(--highlight);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .svc-visual-icon {
    position: relative;
    display: grid; place-items: center;
    width: 148px; height: 148px;
    border-radius: 28px;
    background: var(--night);
    color: var(--white);
    box-shadow: 0 30px 60px -20px rgba(0, 49, 82, 0.45);
    animation: float 6s ease-in-out infinite;
  }
  .svc-chev { position: absolute; fill: var(--sky); }
  .c1 { width: 70%; left: -12%; bottom: 6%; animation: drift 9s ease-in-out infinite; }
  .c2 { width: 46%; right: -8%; top: 8%; opacity: 0.6; animation: drift 11s ease-in-out infinite reverse; }
  @keyframes float { 50% { transform: translate3d(0, -10px, 0); } }
  @keyframes drift { 50% { transform: translate3d(10px, -14px, 0); } }

  .in { animation: ph 1s var(--ease) both; animation-delay: var(--d, 0s); }
  @keyframes ph { from { opacity: 0; transform: translate3d(0, 20px, 0); } }

  @media (min-width: 960px) {
    .svc-hero-grid { grid-template-columns: 7fr 5fr; gap: 4rem; }
  }

  .bento { display: grid; gap: 16px; }
  .cell { border-radius: var(--radius); padding: clamp(28px, 3.5vw, 48px); background: var(--soft); }
  .cell h2 { margin-bottom: 1.5rem; }
  .cell-a { min-height: 340px; background: var(--night); }
  .cell-c { display: flex; flex-direction: column; gap: 0.5rem; justify-content: flex-end; color: var(--night); }
  .cell-c h2 { margin: 1.5rem 0 0; font-family: var(--font-text); letter-spacing: 0; }
  .cell-c p { margin: 0; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chips li {
    padding: 0.55rem 1rem;
    border-radius: 8px;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.9375rem;
  }
  @media (min-width: 800px) {
    .bento { grid-template-columns: repeat(6, 1fr); }
    .cell-a { grid-column: span 4; grid-row: span 2; }
    .cell-b { grid-column: span 2; }
    .cell-c { grid-column: span 2; }
    .cell-d { grid-column: span 6; }
  }

  .block-title { margin-bottom: clamp(32px, 5vw, 56px); }
  .rel-grid { display: grid; gap: 40px 24px; }
  @media (min-width: 720px) { .rel-grid { grid-template-columns: 1fr 1fr; } }

  .faq-grid { display: grid; gap: 2rem; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: 5fr 7fr; gap: 4rem; } }
</style>
