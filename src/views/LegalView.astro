---
import Layout from '../layouts/Layout.astro';
import { routes, useT, otherLang, type Lang } from '../i18n/ui';
import { legal, type LegalKey } from '../data/legal';

interface Props { lang: Lang; page: LegalKey }
const { lang, page } = Astro.props;
const t = useT(lang);
const doc = legal[page][lang];
---
<Layout lang={lang} title={doc.title} description={doc.description} altHref={routes[page][otherLang(lang)]}>
  <article class="legal container container-narrow">
    <h1 class="t-1">{doc.title}</h1>
    <p class="muted small updated">{t('legal.updated')} : {doc.updated}</p>
    <div class="callout draft"><p>{doc.draftNote}</p></div>
    <div class="prose">
      {doc.sections.map((s) => (
        <section>
          <h2 class="t-4">{s.h}</h2>
          {s.p.map((p) => <p set:html={p} />)}
        </section>
      ))}
    </div>
  </article>
</Layout>

<style>
  .legal { padding-top: clamp(56px, 8vw, 112px); padding-bottom: var(--section-pad); }
  .updated { margin: 1rem 0 2rem; }
  .draft { margin-bottom: 3rem; font-size: 0.9375rem; }
  .prose section + section { margin-top: 2.5rem; }
  .prose h2 { margin-bottom: 0.75rem; }
  .prose p { color: var(--ink); }
</style>
