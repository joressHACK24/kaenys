---
// Lecteur vidéo léger : miniature seule, le lecteur YouTube n'est chargé qu'au clic.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="lv" data-lite-video={id}>
  <img src={`https://i.ytimg.com/vi_webp/${id}/hqdefault.webp`} alt="" loading="lazy" decoding="async" width="480" height="360" />
  <button type="button" class="lv-play" aria-label={title}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7v10l8-5z" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lite-video]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.dataset.liteVideo;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = el.querySelector('button')?.getAttribute('aria-label') ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style>
  .lv { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--night); }
  .lv img, .lv :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .lv-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--night);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.3s var(--ease);
  }
  .lv-play:hover { transform: scale(1.06); }
  .lv-play svg { width: 30px; fill: currentColor; margin-left: 4px; }
</style>
