---
import WorkImage from './WorkImage.astro';
import Icon from './Icon.astro';
import { projectPath, categories, type Project } from '../data/projects';
import { useT, type Lang } from '../i18n/ui';

interface Props { project: Project; lang: Lang; delay?: number; level?: 2 | 3; sizes?: string }
const {
  project: p,
  lang,
  delay = 0,
  level = 3,
  sizes = '(min-width: 1100px) 380px, (min-width: 720px) 50vw, 100vw',
} = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const t = useT(lang);
const cover = p.images.find((i) => i.file === p.cover) ?? p.images[0];
---
<article class="pcard" data-reveal style={`--delay:${delay}ms`} data-categories={p.categories.join(' ')}>
  <a href={projectPath(p, lang)} class="pcard-link" data-tilt>
    <div class="pcard-media">
      <WorkImage file={p.cover} alt={cover.alt[lang]} sizes={sizes} widths={[320, 480, 720, 1080]} />
      {!p.authorized && <span class="badge pcard-badge">{t('work.pending')}</span>}
      <span class="pcard-go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
    </div>
    <div class="pcard-body">
      <p class="pcard-cat small">{p.categories.map((c) => categories[c][lang]).join(' · ')}</p>
      <Heading class="t-4">{p.client}</Heading>
      <p class="pcard-sector muted">{p.sector[lang]}</p>
    </div>
  </a>
</article>

<style>
  .pcard { display: flex; }
  .pcard-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }
  .pcard-media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--soft);
    transform: translateZ(0);
  }
  .pcard-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 1.1s var(--ease);
  }
  .pcard-link:hover .pcard-media :global(img) { transform: scale(1.05); }
  .pcard-badge { position: absolute; top: 14px; left: 14px; }

  .pcard-go {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    color: var(--night);
    opacity: 0;
    transform: translate3d(0, 10px, 0) rotate(-45deg);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }
  .pcard-link:hover .pcard-go, .pcard-link:focus-visible .pcard-go { opacity: 1; transform: rotate(-45deg); }

  .pcard-body { padding: 18px 4px 0; }
  .pcard-cat { color: var(--muted); margin-bottom: 0.35rem; }
  .pcard-sector { margin: 0.3rem 0 0; font-size: 0.9375rem; }
  .pcard-link:hover .t-4 { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1.5px; }
</style>
