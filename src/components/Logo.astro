---
import { SYMBOL_PATH, WORDMARK_PATH } from '../data/logo';

interface Props {
  /** "dark" = bleu nuit sur fond clair, "light" = blanc sur fond bleu nuit */
  tone?: 'dark' | 'light';
  symbolOnly?: boolean;
  class?: string;
  title?: string;
}
const { tone = 'dark', symbolOnly = false, class: cls = '', title = 'Kaenys' } = Astro.props;
const symbolFill = tone === 'dark' ? '#ADDFF1' : '#FFFFFF';
const wordFill = tone === 'dark' ? '#003152' : '#FFFFFF';
const viewBox = symbolOnly ? '0 0 240 249' : '0 0 1141 249';
---
<svg class={`logo ${cls}`} viewBox={viewBox} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <path d={SYMBOL_PATH} fill={symbolFill} fill-rule="evenodd" stroke={tone === 'dark' ? '#003152' : 'none'} stroke-width="1.5" />
  {!symbolOnly && <path d={WORDMARK_PATH} fill={wordFill} fill-rule="evenodd" />}
</svg>

<style>
  .logo { display: block; height: 100%; width: auto; }
</style>
