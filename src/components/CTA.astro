---
import Icon from './Icon.astro';
import { routes, useT, type Lang } from '../i18n/ui';
import { whatsappLink } from '../config';

interface Props { lang: Lang; href?: string; waMessage?: string }
const { lang, href, waMessage } = Astro.props;
const t = useT(lang);
---
<section class="cta section bg-night" aria-labelledby="cta-title">
  <div class="container center-col">
    <svg class="cta-motif" viewBox="0 0 234 118" aria-hidden="true"><path d="M115 0 234 117H167L115 65 64 117H0Z" /></svg>
    <h2 id="cta-title" class="t-1" data-reveal>{t('home.cta.title')}</h2>
    <p class="lead" data-reveal style="--delay:80ms">{t('home.cta.sub')}</p>
    <div class="actions center" data-reveal style="--delay:160ms">
      <a class="btn btn-light btn-lg" href={href ?? routes.contact[lang]}>{t('nav.quote')}</a>
      <a class="link-arrow" href={whatsappLink(waMessage ?? t('wa.message'))} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} /> {t('wa.label')}
      </a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; text-align: center; }
  .center-col { position: relative; display: flex; flex-direction: column; align-items: center; }
  .cta h2 { max-width: 14ch; }
  .cta .lead { margin-top: 1.25rem; max-width: 38ch; }
  .cta .actions { margin-top: 2.25rem; }
  .cta-motif {
    width: 120px;
    fill: var(--sky);
    margin-bottom: 2.5rem;
  }
</style>
