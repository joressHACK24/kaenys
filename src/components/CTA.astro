---
import Icon from './Icon.astro';
import { routes, useT, type Lang } from '../i18n/ui';
import { whatsappLink } from '../config';

interface Props { lang: Lang; href?: string; waMessage?: string }
const { lang, href, waMessage } = Astro.props;
const t = useT(lang);
---
<section class="cta section bg-night" aria-labelledby="cta-title">
  <div class="container center-col">
    <svg class="cta-motif" viewBox="0 0 234.22 118.8" aria-hidden="true"><path d="M65.52 118.8L2.23 118.8C1.39 118.8 0.64 118.29 0.32 117.52C0 116.76 0.17 115.87 0.76 115.28L113.52 1.48C114.97 0.01 117.33 0 118.79 1.45L233.34 114.76C234.02 115.44 234.22 116.45 233.86 117.34C233.5 118.22 232.64 118.8 231.68 118.8L166.76 118.8L116.14 66.51L65.52 118.8Z" /></svg>
    <svg class="cta-big" viewBox="0 0 234.22 118.8" aria-hidden="true" data-parallax="0.2"><path d="M65.52 118.8L2.23 118.8C1.39 118.8 0.64 118.29 0.32 117.52C0 116.76 0.17 115.87 0.76 115.28L113.52 1.48C114.97 0.01 117.33 0 118.79 1.45L233.34 114.76C234.02 115.44 234.22 116.45 233.86 117.34C233.5 118.22 232.64 118.8 231.68 118.8L166.76 118.8L116.14 66.51L65.52 118.8Z" /></svg>
    <h2 id="cta-title" class="t-1" data-split>{t('home.cta.title')}</h2>
    <p class="lead" data-reveal style="--delay:80ms">{t('home.cta.sub')}</p>
    <div class="actions" data-reveal style="--delay:160ms">
      <a class="btn btn-light btn-lg" href={href ?? routes.contact[lang]}>{t('nav.quote')}</a>
      <a class="link-arrow" href={whatsappLink(waMessage ?? t('wa.message'))} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} /> {t('wa.label')}
      </a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; }
  .center-col { position: relative; display: flex; flex-direction: column; align-items: flex-start; }
  .cta h2, .cta .lead, .cta .actions { position: relative; }
  .cta h2 { max-width: 14ch; }
  .cta .lead { margin-top: 1.25rem; max-width: 38ch; }
  .cta .actions { margin-top: 2.25rem; }
  .cta-big {
    position: absolute;
    right: -12%;
    top: 10%;
    width: min(70vw, 720px);
    fill: var(--sky);
    opacity: 0.07;
    pointer-events: none;
  }
  .cta-motif {
    width: 120px;
    fill: var(--sky);
    margin-bottom: 2.5rem;
  }
</style>
