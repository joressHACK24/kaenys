---
// Bandeau qui défile en continu avec les six expertises, séparées par le chevron du « K ».
import { services, servicePath } from '../data/services';
import { useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const items = services.map((s) => ({ label: s.title[lang], href: servicePath(s, lang) }));
---
<section class="marquee" aria-label={t('marquee.label')}>
  <div class="marquee-track">
    {[0, 1].map((copy) => (
      <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((it) => (
          <li>
            <a href={it.href} tabindex={copy === 1 ? -1 : undefined}>{it.label}</a>
            <svg viewBox="0 0 234.22 118.8" aria-hidden="true"><path d="M65.52 118.8L2.23 118.8C1.39 118.8 0.64 118.29 0.32 117.52C0 116.76 0.17 115.87 0.76 115.28L113.52 1.48C114.97 0.01 117.33 0 118.79 1.45L233.34 114.76C234.02 115.44 234.22 116.45 233.86 117.34C233.5 118.22 232.64 118.8 231.68 118.8L166.76 118.8L116.14 66.51L65.52 118.8Z" /></svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    background: var(--sky);
    color: var(--night);
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 28px) 0;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }
  .marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  .marquee-group {
    display: flex;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee li { display: flex; align-items: center; }
  .marquee a {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    padding: 0 clamp(18px, 2.4vw, 36px);
  }
  .marquee a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 8px; }
  .marquee svg { width: clamp(22px, 2.6vw, 34px); fill: var(--blue); flex-shrink: 0; }
  @keyframes marquee { to { transform: translate3d(-50%, 0, 0); } }

  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
    .marquee-track { animation: none; }
  }
</style>
