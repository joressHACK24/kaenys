---
import Icon from './Icon.astro';
import { services, servicePath } from '../data/services';
import { useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang; exclude?: string }
const { lang, exclude } = Astro.props;
const t = useT(lang);
const list = services.filter((s) => s.id !== exclude);
---
<ul class="tiles">
  {list.map((s, i) => (
    <li data-reveal style={`--delay:${(i % 3) * 80}ms`}>
      <a class="tile" href={servicePath(s, lang)}>
        <span class="tile-icon"><Icon name={s.icon} size={28} /></span>
        <h3 class="t-4 tile-title">{s.title[lang]}</h3>
        <p class="tile-text">{s.short[lang]}</p>
        <span class="tile-more">{t('service.more')} <Icon name="chevron" size={14} /></span>
        <svg class="tile-motif" viewBox="0 0 234 118" aria-hidden="true"><path d="M115 0 234 117H167L115 65 64 117H0Z" /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  @media (min-width: 1024px) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .tiles li { display: flex; }
  .tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 300px;
    padding: 32px;
    border-radius: var(--radius);
    background: var(--white);
    text-decoration: none;
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--line);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  :global(.bg-soft) .tile { box-shadow: none; }
  .tile:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -18px rgba(0, 49, 82, 0.28); }

  .tile-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--highlight);
    color: var(--night);
  }
  .tile-title { margin-top: 56px; }
  .tile-text { color: var(--muted); margin: 0.6rem 0 1.25rem; font-size: 1rem; }
  .tile-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--night);
  }
  .tile-more :global(svg) { transition: transform 0.3s var(--ease); }
  .tile:hover .tile-more :global(svg) { transform: translateX(3px); }

  .tile-motif {
    position: absolute;
    right: -24px;
    top: 20px;
    width: 150px;
    fill: var(--highlight);
    opacity: 0;
    transform: translate3d(20px, 20px, 0);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    pointer-events: none;
  }
  .tile:hover .tile-motif { opacity: 1; transform: none; }
  .tile > :not(.tile-motif) { position: relative; z-index: 1; }
</style>
