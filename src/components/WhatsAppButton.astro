---
import Icon from './Icon.astro';
import { whatsappLink } from '../config';

interface Props { label: string; message: string }
const { label, message } = Astro.props;
---
<a class="wa" href={whatsappLink(message)} target="_blank" rel="noopener" aria-label={label}>
  <Icon name="whatsapp" size={26} />
  <span class="wa-label" aria-hidden="true">{label}</span>
</a>

<style>
  .wa {
    position: fixed;
    right: calc(16px + env(safe-area-inset-right));
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0;
    height: 56px;
    min-width: 56px;
    padding: 0 15px;
    border-radius: 28px;
    background: var(--night);
    color: var(--white);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 49, 82, 0.28), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .wa:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0, 49, 82, 0.34); }
  .wa-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: max-width 0.45s var(--ease), margin 0.45s var(--ease);
  }
  @media (hover: hover) and (min-width: 960px) {
    .wa:hover .wa-label, .wa:focus-visible .wa-label { max-width: 260px; margin-left: 10px; margin-right: 4px; }
  }
  :global(html.menu-open) .wa { display: none; }
</style>
